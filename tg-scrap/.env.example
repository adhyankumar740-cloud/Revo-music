# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here

# Your EXISTING string session (since you already have one, no OTP login needed)
TELEGRAM_SESSION=your_string_session_here

# Comma separated list of channels to download (username, public name, or numeric id)
CHANNELS=channel_username_1,channel_username_2,channel_username_3,channel_username_4,channel_username_5

# Invent a random secret - required as the x-api-key header to trigger downloads
APP_SECRET=change_this_to_something_random

# Where files get saved. On Render, point this at your mounted persistent disk.
EXPORT_DIR=/data/export

# Render sets this automatically - safe to leave as is
PORT=10000
